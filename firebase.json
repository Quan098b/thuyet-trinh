{
  "functions": {
    "source": ".",
    "runtime": "python312",
    "ignore": [
      "public/**",
      "templates/**",
      "*.md",
      "Dockerfile",
      ".dockerignore",
      "__pycache__",
      "**/__pycache__/**",
      ".git/**",
      "node_modules/**"
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "function": "owaspapp"
      }
    ]
  }
}
